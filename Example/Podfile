platform :ios, "15.0"
use_frameworks! :linkage => :static

def pod_Common
  pod "JSCoreKit", :path => ".."
end

target "JSCoreKitExample" do
  pod_Common
  pod 'SwiftLint', :configurations => ['Debug']
  pod "LookInsideServer", :git => "https://github.com/LookInsideApp/LookInside-Release.git", :configurations => ['Debug']
  pod "MLeaksFinder", :git => "https://github.com/Tencent/MLeaksFinder.git", :configurations => ["Debug"]
end

def set_deployment_target(target)
  target.build_configurations.each do |config|
    config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    set_deployment_target(target)
  end
end